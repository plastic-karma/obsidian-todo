    {
      "name": "multiline and exact inline code spans",
      "task_path": "Tasks/task.md",
      "body": "``example ` [no](../Attachments/no.pdf) ``\n`example\n[[Attachments/no.pdf]]`\n[yes](../Attachments/yes.pdf)\n",
      "paths": [
        "Attachments/yes.pdf"
      ],
      "unlink_path": "Attachments/yes.pdf",
      "unlinked": "``example ` [no](../Attachments/no.pdf) ``\n`example\n[[Attachments/no.pdf]]`\n\n"
    },
    {
      "name": "escaped syntax",
      "task_path": "Tasks/task.md",
      "body": "\\[not](../Attachments/no.pdf) \\\\[yes](../Attachments/yes.pdf)\n",
      "paths": [
        "Attachments/yes.pdf"
      ],
      "unlink_path": "Attachments/yes.pdf",
      "unlinked": "\\[not](../Attachments/no.pdf) \\\\\n"
    },
    {
      "name": "fence requires empty closing suffix",
      "task_path": "Tasks/task.md",
      "body": "```\n``` not a closer\n[[Attachments/no.pdf]]\n```\n[[Attachments/yes.pdf]]\n",
      "paths": [
        "Attachments/yes.pdf"
      ],
