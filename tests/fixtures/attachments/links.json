    {
      "name": "ambiguous external unsafe",
      "task_path": "Tasks/task.md",
      "body": "[[receipt.pdf]] [external](https://example.org/Attachments/x.pdf) [escape](../../Attachments/x.pdf) [bad](../Attachments/../Tasks/x.md)\n",
      "paths": [],
      "unlink_path": "Attachments/x.pdf",
      "unlinked": "[[receipt.pdf]] [external](https://example.org/Attachments/x.pdf) [escape](../../Attachments/x.pdf) [bad](../Attachments/../Tasks/x.md)\n"
    },
    {
      "name": "duplicate fragments and title",
